# Frontend Environment Variables

# LOCAL DEVELOPMENT
# Point to local backend
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# STAGING
# Uncomment and update for staging environment
# NEXT_PUBLIC_API_URL=https://staging-api.yourdomain.com/api

# PRODUCTION
# Uncomment and update for production environment (AWS EC2 or similar)
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# For AWS EC2 deployments, use the following format:
# NEXT_PUBLIC_API_URL=https://your-ec2-instance-public-ip-or-domain/api
# Or if using AWS API Gateway:
# NEXT_PUBLIC_API_URL=https://your-api-gateway-endpoint/api

# Optional: Analytics, monitoring, etc.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# NOTE: All variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Do NOT put secrets here (API keys, database credentials, etc.)
# Use server-side .env variables for secrets
